# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sanity (server-only; https://www.sanity.io/manage → API → Tokens, Viewer role)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Sanity Context MCP (server-only; slug URL of the "vertex-search" Context doc, studio/scripts/context/vertex-search.json)
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/<projectId>/production/vertex-search

# Google Gemini (server-only; search route; free key at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# PostHog (client-safe project key; https://app.posthog.com → Project settings)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
