# Sanity project (https://www.sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Video ingestion (optional, only for Vimeo/Bunny lesson URLs; YouTube needs none).
# Never prefix with SANITY_STUDIO_ — that would bundle them into the deployed Studio.
# Pass in the shell: VIMEO_ACCESS_TOKEN=… npm run ingest
VIMEO_ACCESS_TOKEN=
BUNNY_STREAM_API_KEY=
BUNNY_CDN_HOSTNAME=
